# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL="file:./prisma/dev.db"

# Inji Certify (issuer). Collab sandbox supports Authorization Code only.
CERTIFY_BASE_URL=
# Local Certify (Docker) for Pre-Authorized Code runs
CERTIFY_LOCAL_BASE_URL=http://localhost:8090

# Mimoto (wallet backend for Inji Wallet / Inji Web)
MIMOTO_BASE_URL=
INJI_WEB_BASE_URL=

# Inji Verify (verifier)
VERIFY_BASE_URL=

# External, non-Inji stack used to prove interop beyond Inji
EXTERNAL_ISSUER_BASE_URL=https://playground.animo.id
EXTERNAL_VERIFIER_BASE_URL=https://playground.animo.id

# Public https base for this backend when a mobile wallet must reach it (ngrok / cloudflared)
PUBLIC_BASE_URL=
