generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Run {
  id                 String   @id
  issuer             String
  wallet             String
  verifier           String
  format             String
  kind               String   @default("workflow")
  status             String
  verificationResult String?
  verificationEvidence String?
  errorStep          String?
  errorMessage       String?
  createdAt          DateTime @default(now())
  steps              Step[]

  @@index([createdAt])
  credentials        Credential[]
  offerOperation     OfferOperation?
}

model Step {
  id           String   @id
  runId        String
  run          Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  name         String
  stage        String
  fromParty    String
  toParty      String
  requestJson  String
  responseJson String?
  httpStatus   Int?
  ok           Boolean
  durationMs   Int
  timestamp    DateTime

  @@index([runId])
}

model Credential {
  id            String   @id
  runId         String   @unique
  run           Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  format        String
  credentialJson String
  status        String
  issuedAt      DateTime @default(now())
  demo          Boolean  @default(true)
}

model OfferOperation {
  id                       String   @id
  runId                    String   @unique
  run                      Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  requestFingerprint       String
  credentialConfigurationId String
  format                   String
  status                   String
  offerUri                 String?
  issuerUrl                String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([status])
}
